{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "strict": true
  },
  // App code only for now; test files rely heavily on loosely-typed mocks.
  "include": [
    ".svelte-kit/types/**/$types.d.ts",
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/**/*.svelte"
  ]
}
