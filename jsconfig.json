{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "strict": true
  },
  // App code, strict. Tests have their own non-strict config: tests/jsconfig.json.
  "include": [
    ".svelte-kit/types/**/$types.d.ts",
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/**/*.svelte"
  ]
}
